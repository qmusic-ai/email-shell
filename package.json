{
  "name": "@qmusic/email-shell",
  "version": "1.1.0",
  "description": "Q Music transactional email shell: the warm light card every client and artist email renders in.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmusic-ai/email-shell.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "golden:write": "npm run build && node scripts/write-golden.mjs",
    "prepublishOnly": "npm test && node scripts/assert-release.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
